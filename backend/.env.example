# ============================================================
# Attendance Tracker Backend - Environment Configuration Example
# Copy this file to '.env' and modify the values as needed.
# ============================================================

# Database Connection (Supabase / Postgres URI)
# In production (Railway), set this variable to your Supabase connection string.
DATABASE_URL=postgresql://username:password@hostname:port/dbname

# Authentication
# Secret key used for signing JWT login sessions.
# MUST be set to a strong, unique secret key in production.
# If omitted on start, a temporary secure random secret will be generated.
JWT_SECRET=your_jwt_secret_key_change_me_to_something_secure_and_long

# Telegram Bot
# Your Telegram Bot API token, received from @BotFather.
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Webhook Configuration (Railway Production)
# Set to 'true' to use webhooks instead of polling.
USE_WEBHOOK=false
# The public domain of your Railway backend service (no trailing slash).
# Required only if USE_WEBHOOK=true. E.g. https://your-backend-app.up.railway.app
PUBLIC_URL=

# Host Settings
PORT=4000

# CORS Configuration
# Comma-separated list of allowed frontend origins (no trailing slash).
# Set to your frontend custom domain in production.
# E.g., FRONTEND_URL=https://smartlearningplus.com
FRONTEND_URL=http://localhost:5173

# Admin Account Bootstrapping
# On first run, if the database admin list is empty, a default admin
# account will be bootstrapped with these credentials.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin1234

# Attendance Settings
# The threshold percentage below which warning alerts will trigger.
ATTENDANCE_THRESHOLD=75
